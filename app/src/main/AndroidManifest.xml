<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Météo (Open-Meteo), lecture (flux RSS, Wikipédia) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nécessaire (Android 11+) pour lister les applis lançables et les widgets installés -->
    <queries>
        <package android:name="com.anthropic.claude" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Noir">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateHidden|adjustResize">

            <!-- Écran d'accueil -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Permet de le lancer comme une appli normale -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Bloqueur de Shorts YouTube (à activer dans Paramètres > Accessibilité) -->
        <service
            android:name=".ShortsBlockerService"
            android:exported="false"
            android:label="@string/shorts_blocker_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shorts_blocker" />
        </service>
    </application>
</manifest>
